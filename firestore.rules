rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validTag(tags, index) {
      return tags.size() <= index || (tags[index] is string && tags[index].size() <= 24);
    }

    function validTags(tags) {
      return tags is list
        && tags.size() <= 10
        && validTag(tags, 0)
        && validTag(tags, 1)
        && validTag(tags, 2)
        && validTag(tags, 3)
        && validTag(tags, 4)
        && validTag(tags, 5)
        && validTag(tags, 6)
        && validTag(tags, 7)
        && validTag(tags, 8)
        && validTag(tags, 9);
    }

    function validAttachment(file) {
      return file is map
        && file.keys().hasOnly(["id", "name", "type", "size", "dataUrl", "createdAt"])
        && file.id is string
        && file.id.size() <= 80
        && file.name is string
        && file.name.size() >= 1
        && file.name.size() <= 120
        && file.type is string
        && file.type.size() <= 100
        && file.size is number
        && file.size >= 0
        && file.size <= 225280
        && file.dataUrl is string
        && file.dataUrl.size() <= 320000
        && file.createdAt is string
        && file.createdAt.size() <= 40;
    }

    function validAttachmentAt(files, index) {
      return files.size() <= index || validAttachment(files[index]);
    }

    function validAttachments(files) {
      return files is list
        && files.size() <= 3
        && validAttachmentAt(files, 0)
        && validAttachmentAt(files, 1)
        && validAttachmentAt(files, 2);
    }

    function validNote(data) {
      return data.keys().hasOnly(["title", "body", "tags", "notebook", "type", "archived", "attachments", "updatedAt", "favorite", "pinned", "reminderAt"])
        && data.keys().hasAll(["title", "body", "tags", "notebook", "type", "archived", "attachments", "updatedAt", "favorite", "pinned"])
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.body is string
        && data.body.size() >= 1
        && data.body.size() <= 10000
        && validTags(data.tags)
        && data.notebook is string
        && data.notebook.size() >= 1
        && data.notebook.size() <= 32
        && data.type is string
        && (data.type == "text" || data.type == "checklist")
        && data.archived is bool
        && validAttachments(data.attachments)
        && data.updatedAt is string
        && data.updatedAt.size() <= 40
        && data.favorite is bool
        && data.pinned is bool
        && (!data.keys().hasAny(["reminderAt"]) || (data.reminderAt is string && data.reminderAt.size() <= 40));
    }

    // ログインした本人だけが、自分のノートを読み書きできる
    match /users/{userId}/notes/{noteId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validNote(request.resource.data);
    }
  }
}
